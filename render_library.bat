@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0"
set PYTHONUTF8=1
set PYTHONIOENCODING=utf-8

echo ================================================
echo   Предрендер библиотеки через ntsc-rs
echo ================================================
echo.
echo Прогоняет каждый файл сериалов/рекламы/заставок через ntsc-rs-cli
echo (аналоговая VHS/NTSC деградация картинки) и кэширует результат.
echo Уже обработанные и неизменившиеся файлы пропускаются - можно
echo спокойно останавливать (Ctrl+C) и запускать заново.
echo.
echo Это ДОЛГИЙ процесс - вся библиотека может занять около суток.
echo Канал можно не выключать: пока файл ещё не обработан, эфир
echo временно использует живой VHS-фильтр в OBS вместо ntsc-rs.
echo.

".venv\Scripts\python.exe" -m director.render_library

echo.
echo Готово.
pause
